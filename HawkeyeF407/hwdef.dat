# MCU class and specific type
# MCU STM32F4xx STM32F407xx
# MCU STM32F4xx STM32F405xx
MCU STM32F4xx STM32F407xx

# board ID for firmware load 1078
APJ_BOARD_ID 1150

# =========================
# CLOCK / FLASH 
# =========================
# crystal frequency
OSCILLATOR_HZ 8000000

# bootloader starts firmware at 64k
# FLASH_RESERVE_START_KB 64
# FLASH_SIZE_KB 1024

FLASH_RESERVE_START_KB 64
FLASH_SIZE_KB 1024
STORAGE_FLASH_PAGE 1
define HAL_STORAGE_SIZE 15360

# store parameters in pages 1 and 2
STORAGE_FLASH_PAGE 1
define HAL_STORAGE_SIZE 15360

# =========================
# SYSTEM TIMER
# =========================

define STM32_ST_USE_TIMER 5
define CH_CFG_ST_RESOLUTION 32

# =========================
# LED
# =========================

PB2 LED0 OUTPUT LOW GPIO(90) # blue marked as ACT
PA5 LED1 OUTPUT LOW GPIO(91) # green marked as B/E
define HAL_GPIO_A_LED_PIN 91
define HAL_GPIO_B_LED_PIN 90
define HAL_GPIO_LED_OFF 1

# =========================
# USB & SWD
# =========================
# order of UARTs (and USB)
SERIAL_ORDER OTG1 USART1 USART2 UART4 USART6 USART3
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# =========================
# ADC
# =========================

PC4 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC5 BATT_CURRENT_SENS ADC1 SCALE(1)
PB0 RSSI_ADC_PIN      ADC1 SCALE(1)
PC0 PRESSURE_SENS     ADC1 SCALE(1)
define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATT_VOLT_PIN 14
define HAL_BATT_VOLT_SCALE 21.0
define HAL_BATT_CURR_PIN 15
define HAL_BATT_CURR_SCALE 66.7
define BOARD_RSSI_ANA_PIN 8
# define HAL_DEFAULT_AIRSPEED_PIN 10

# =========================
# SPI & I2C
# =========================

# --------------------- SPI ---------------------------
# keep SPI2 only for OSD, IMU moved to I2C for GY-91 stability
# - MPU9250/GY-91 via SPI
PB13 SPI2_SCK  SPI2
PC2  SPI2_MISO SPI2
PC3  SPI2_MOSI SPI2

# PC1  OSD_CS  CS
PB12 MPU_CS  CS
PD14 BARO_CS CS

# SPIDEV osd  SPI2 DEVID2 OSD_CS  MODE0 10*MHZ 10*MHZ
SPIDEV imu  SPI2 DEVID1 MPU_CS  MODE3 1*MHZ 8*MHZ
SPIDEV baro SPI2 DEVID3 BARO_CS MODE0 1*MHZ 8*MHZ

# --------------------- I2C ---------------------------
# only one I2C bus, used by GY-91 (MPU9250 + BMP280)
I2C_ORDER I2C2
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

# more stable for GY-91 wiring and long dupont cables
# 100kHz is slower but usually much more reliable than 400kHz
# on cheap breakout boards

# define HAL_I2C_MAX_CLOCK 400000
# define HAL_I2C_MAX_CLOCK 100000
define HAL_I2C_MAX_CLOCK 300000
PC8 SDIO_D0 SDIO
PC9 SDIO_D1 SDIO
PC10 SDIO_D2 SDIO
PC11 SDIO_D3 SDIO
PC12 SDIO_CK SDIO
PD2 SDIO_CMD SDIO

# =========================
# UART SERIAL
# =========================

DMA_PRIORITY ADC1 SPI2* TIM1* TIM2* TIM3* TIM4* UART2*

# USART1 / SERIAL1
PB6 USART1_TX USART1
PB7 USART1_RX USART1

# USART2 / SERIAL2
PA2 USART2_TX USART2
PA3 USART2_RX USART2

# USART4 / SERIAL3
PA0 UART4_TX UART4 NODMA
PA1 UART4_RX UART4 NODMA

# USART6 / SERIAL4
PC6 USART6_TX USART6
PC7 USART6_RX USART6 NODMA

# USART3 / SERIAL5
PD8 USART3_TX USART3
PD9 USART3_RX USART3

# =========================
# CAN BUS
# =========================

PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1

define HAL_CAN_POOL_SIZE 16000
define HAL_ENABLE_DRONECAN_DRIVERS 1


# =========================
# PWM
# =========================
# PB5  TIM3_CH2  TIM3  PWM(1) GPIO(50)
# PB3  TIM2_CH2  TIM2  PWM(2) GPIO(51)
# PB15 TIM12_CH2 TIM12 PWM(3) GPIO(52) NODMA
# PB14 TIM12_CH1 TIM12 PWM(4) GPIO(53) NODMA
# PA7  TIM14_CH1 TIM14 PWM(5) GPIO(54) NODMA
# PA6  TIM13_CH1 TIM13 PWM(6) GPIO(55) NODMA
# PB1  TIM3_CH4  TIM3  PWM(7) GPIO(56)
# PD12 TIM4_CH1  TIM4  PWM(8) GPIO(57)

# -------- MAIN OUT --------
PB5  TIM3_CH2  TIM3  PWM(1) GPIO(50)
PB3  TIM2_CH2  TIM2  PWM(2) GPIO(51)
PB15 TIM12_CH2 TIM12 PWM(3) GPIO(52) NODMA
PB14 TIM12_CH1 TIM12 PWM(4) GPIO(53) NODMA
PA7  TIM14_CH1 TIM14 PWM(5) GPIO(54) NODMA
PA6  TIM13_CH1 TIM13 PWM(6) GPIO(55) NODMA
PB1  TIM3_CH4  TIM3  PWM(7) GPIO(56)
PD12 TIM4_CH1  TIM4  PWM(8) GPIO(57)

# define STM32_PWM_USE_ADVANCED TRUE

# =========================
# BUZZER
# =========================
PB9 TIM11_CH1  TIM11 GPIO(32) ALARM


# define OSD_ENABLED 1
# define HAL_OSD_TYPE_DEFAULT 1
# ROMFS_WILDCARD libraries/AP_OSD/fonts/font0.bin

# =========================
# Inertial Measurement Unit
# =========================

# ------------------ GYRO/BARO -------------------------
# GY-91 uses shared I2C lines. Using all-I2C avoids the SPI/I2C pin conflict
# that caused unstable init/disconnect behavior.
# MPU9250 default address is usually 0x68 when AD0/SDO is low.
# If your board is strapped high, change 0x68 to 0x69.
# ----- I2C MODE -----
# IMU Invensense I2C:0:0x68 ROTATION_NONE
# BARO BMP280 I2C:0:0x76
# BARO BMP280 I2C:0:0x77

# ----- SPI MODE -----
IMU Invensense SPI:imu ROTATION_NONE
BARO BMP280 SPI:baro

# ------------------ COMPASS -------------------------
# for best results use an external compass, or verify separately later.

define AP_COMPASS_PROBING_ENABLED 2
define HAL_PROBE_EXTERNAL_I2C_COMPASSES
define HAL_I2C_INTERNAL_MASK 0
define COMPASS_EXTERNAL_I2C_BUS 0
define HAL_COMPASS_ALLOW_PRIMARY_I2C
define HAL_DEFAULT_INS_FAST_SAMPLE 0

# enable FAT filesystem
# =========================
# SYSTEM & SCRIPTING
# =========================

define HAL_OS_FATFS_IO 1
define HAL_BOARD_LOG_DIRECTORY "/APM/LOGS"
define HAL_USE_SDC TRUE
define STM32_SDC_USE_SDIO TRUE
define USE_POSIX

# disable parachute and sprayer to save flash
define HAL_PARACHUTE_ENABLED 0
define HAL_SPRAYER_ENABLED 0

# reduce max size of embedded params for apj_tool.py
define AP_PARAM_MAX_EMBEDDED_PARAM 1024


# =========================
# SAFE FLASH
# =========================

define AP_BATTMON_SMBUS_ENABLE 0


#include ../include/minimize_fpv_osd.inc
include ../include/save_some_flash.inc
include ../include/minimize_features.inc

